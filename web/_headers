# Encabezados de seguridad para toda la web (Cloudflare Pages los aplica solo).
# Si se cambia el <script> chico que está en el <head> de index/catalogo/perfume.html,
# hay que actualizar su huella (sha256) en script-src o el navegador lo va a bloquear.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-IT1jzOtsWyPs40LU7guMAuihaHhmCPeZcMkL9QKnTUY=' 'sha256-Z05SOPPlOLizyXjpzKQcSyEwrdRCVGoYUWBrh3bVrj8=' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https:; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/img/*
  Cache-Control: public, max-age=604800

# Los videos llevan la versión en el nombre (…-v1.mp4): si cambian, cambia el nombre.
/video/*
  Cache-Control: public, max-age=31536000, immutable
